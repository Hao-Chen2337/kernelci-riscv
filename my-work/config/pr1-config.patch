diff --git a/config/platforms.yaml b/config/platforms.yaml
index 0a64cb7..d160387 100644
--- a/config/platforms.yaml
+++ b/config/platforms.yaml
@@ -574,6 +574,16 @@ platforms:
       guestfs_interface: virtio
       memory: 4G
 
