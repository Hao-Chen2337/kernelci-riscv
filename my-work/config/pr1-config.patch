diff --git a/config/scheduler-pull-labs.yaml b/config/scheduler-pull-labs.yaml
index b46a56a..2a61d11 100644
--- a/config/scheduler-pull-labs.yaml
+++ b/config/scheduler-pull-labs.yaml
@@ -224,6 +224,33 @@ scheduler:
     platforms:
       - exynos850-e850-96
 
+  - job: baseline-riscv-pull-labs
+    event: &kbuild-gcc-14-riscv-node-event
+      <<: *node-event-kbuild
+      name: kbuild-gcc-14-riscv
+    runtime: &pull-labs-riscv-runtime
+      type: pull_labs
+      name: pull-labs-riscv
+    platforms:
+      - qemu-riscv64
+
+  # The riscv64-kselftest-kernelci build image ships a kselftest tarball for
+  # the plain riscv defconfig build too, so both jobs can use the same event.
+  - job: kselftest-riscv-pull-labs
+    event: *kbuild-gcc-14-riscv-node-event
+    runtime: *pull-labs-riscv-runtime
+    platforms:
+      - qemu-riscv64
+
+  # Hypervisor: the same build ships a kvm module (CONFIG_KVM=m) and a kvm
+  # kselftest collection; the lab boots QEMU with the H extension and runs a
+  # curated subset (perf/stress tests are meaningless under TCG).
+  - job: kselftest-kvm-riscv-pull-labs
+    event: *kbuild-gcc-14-riscv-node-event
+    runtime: *pull-labs-riscv-runtime
+    platforms:
+      - qemu-riscv64
+
   - job: baseline-x86-pull-labs-demo
     event: &kbuild-gcc-15-x86-node-event
       <<: *node-event-kbuild
