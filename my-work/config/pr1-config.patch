diff --git a/config/jobs-pull-labs.yaml b/config/jobs-pull-labs.yaml
index 9354f2a..5d6a966 100644
--- a/config/jobs-pull-labs.yaml
+++ b/config/jobs-pull-labs.yaml
@@ -224,6 +224,24 @@ jobs:
       collection: breakpoints
     kcidb_test_suite: kselftest.breakpoints
 
+  baseline-riscv-pull-labs: *baseline-job-pull-labs
+
+  kselftest-riscv-pull-labs:
+    template: kselftest-pull-labs.jinja2
+    kind: job
+    params:
+      <<: *kselftest-params-pull-labs
+      collection: riscv
+    kcidb_test_suite: kselftest.riscv
+
+  kselftest-kvm-riscv-pull-labs:
+    template: kselftest-pull-labs.jinja2
+    kind: job
+    params:
+      <<: *kselftest-params-pull-labs
+      collection: kvm
+    kcidb_test_suite: kselftest.kvm
+
   baseline-x86-aws-ec2:
     template: baseline.jinja2
     kind: job
diff --git a/config/pipeline-pull-labs.yaml b/config/pipeline-pull-labs.yaml
index e4a4be1..2dc4367 100644
--- a/config/pipeline-pull-labs.yaml
+++ b/config/pipeline-pull-labs.yaml
